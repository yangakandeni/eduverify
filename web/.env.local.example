# Clerk (https://dashboard.clerk.com) — copy this file to .env.local and fill in your instance's keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Google Analytics 4 (https://analytics.google.com) — measurement ID, starts with "G-".
# Loaded via @next/third-parties' <GoogleAnalytics> in app/layout.tsx (components/Analytics.tsx).
# Leave blank locally to skip loading GA entirely — STAGING/PROD set this in the Amplify Console.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# eduverify-api is the source of truth in DEV, STAGING, and PROD.
# USE_EXTERNAL_API=true switches web/lib/institutions.ts from the bundled local seed data
# to eduverify-api. DEV defaults to true, calling a locally-running eduverify-api dev
# server — see the sibling eduverify-api repo's README: `npm run dynamodb:local`, then
# `npm run seed:local`, then `PORT=4000 npm run dev` (its default port 3000 collides with
# this app's own `next dev`). No API key is required locally — the search/get/list routes
# this app calls don't check `x-api-key` (see eduverify-api's src/router.ts). Set to
# "false" here to fall back to the bundled local seed data instead (e.g. offline work, or
# when eduverify-api isn't running).
# STAGING/PROD set these in the Amplify Console, not here.
USE_EXTERNAL_API=true
EDUVERIFY_API_BASE_URL=http://localhost:4000
EDUVERIFY_API_KEY=

# Google Analytics (GA4) measurement ID. GoogleAnalytics.tsx (rendered in app/layout.tsx)
# only injects the gtag.js snippet when this is set — leave blank locally.
# STAGING/PROD set this in the Amplify Console, not here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
