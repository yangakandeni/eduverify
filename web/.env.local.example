# Clerk (https://dashboard.clerk.com) — copy this file to .env.local and fill in your instance's keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# eduverify-api cutover (see plan: monetizing-the-ingestion-engine).
# USE_EXTERNAL_API=true switches web/lib/institutions.ts from DynamoDB/local data to
# eduverify-api — staging only for now; leave unset (or "false") in production until the
# parity check and hero/browse rework are done.
USE_EXTERNAL_API=false
EDUVERIFY_API_BASE_URL=
EDUVERIFY_API_KEY=
