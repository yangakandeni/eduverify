# Clerk (https://dashboard.clerk.com) — copy this file to .env.local and fill in your instance's keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# eduverify-api cutover (see plan: monetizing-the-ingestion-engine).
# USE_EXTERNAL_API=true switches web/lib/institutions.ts from DynamoDB/local data to
# eduverify-api. DEV now defaults to true, calling a locally-running eduverify-api dev
# server — see the sibling eduverify-api repo's README: `npm run dynamodb:local`, then
# `npm run seed:local`, then `PORT=4000 npm run dev` (its default port 3000 collides with
# this app's own `next dev`). No API key is required locally — the search/get/list routes
# this app calls don't check `x-api-key` (see eduverify-api's src/router.ts). Set to
# "false" here to fall back to the bundled local seed data instead.
# STAGING/PROD set these in the Amplify Console, not here; leave PROD "false"/unset until
# the parity check against eduverify-api-prod passes (see docs/DEPLOYMENT.md).
USE_EXTERNAL_API=true
EDUVERIFY_API_BASE_URL=http://localhost:4000
EDUVERIFY_API_KEY=
